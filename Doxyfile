PROJECT_NAME           = "cppqed-multidiagonal"
PROJECT_NUMBER         = 0.4.0
PROJECT_BRIEF          = "Multidiagonal sparse operator algebra for C++QED"

OUTPUT_DIRECTORY       = docs

INPUT                  = include/multidiagonal README.md
STRIP_FROM_INC_PATH    = include
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md
FILTER_PATTERNS        = "*/README.md=sed -E -f doxygen-math.sed"

GENERATE_LATEX         = NO

EXTRACT_ALL            = YES

USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3

GENERATE_TREEVIEW      = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
