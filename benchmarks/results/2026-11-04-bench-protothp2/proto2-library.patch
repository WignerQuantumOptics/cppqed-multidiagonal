+/// @brief The allocator of `StorageType`: a large allocation starts at one of 16 positions within a page, in turn.
+/**
+ * Two large arrays that nearly coincide modulo 1 MiB, e.g. arrays of a multiple of 1 MiB allocated back to back, make
+ * application up to about 3× slower on transparent huge pages (benchmarks/performance.md, "Distance on huge pages", #26).
+ * An allocation of at least 64 KiB therefore gets 8 KiB more, and the array starts at the next page boundary plus
+ * 256 bytes times a position that advances by 5 (mod 16) with every such allocation. Arrays at different positions differ
+ * by at least 256 bytes modulo 4 KiB, hence modulo 1 MiB, whatever their sizes; consecutive allocations always differ.
+ * The address of the underlying block is stored just before the array. Stateless: all instances are equal.
+ */
+template <typename T>
+struct PaddedAllocator
+{
+  using value_type = T;
+
+  static constexpr size_t threshold = 1uz<<16, page = 1uz<<12, step = 256, positions = 16, advance = 5, extra = 2*page;
+
+  PaddedAllocator() = default;
+  template <typename U> constexpr PaddedAllocator(const PaddedAllocator<U>&) noexcept {}
+
+  [[nodiscard]] T* allocate(size_t n)
+  {
+    if (n > (std::numeric_limits<size_t>::max()-extra)/sizeof(T)) throw std::bad_array_new_length{};
+    const size_t b=n*sizeof(T);
+    if (b<threshold) return static_cast<T*>(newBlock(b));
+    char* const block=static_cast<char*>(newBlock(b+extra));
+    const uintptr_t start=(reinterpret_cast<uintptr_t>(block)+sizeof(char*)+page-1)/page*page
+                          + position.fetch_add(1,std::memory_order_relaxed)*advance%positions*step;
+    char* const res=reinterpret_cast<char*>(start);
+    std::memcpy(res-sizeof(char*),&block,sizeof(char*));
+    return reinterpret_cast<T*>(res);
+  }
+
+  void deallocate(T* p, size_t n) noexcept
+  {
+    if (n*sizeof(T)<threshold) {deleteBlock(p); return;}
+    char* block; std::memcpy(&block,reinterpret_cast<char*>(p)-sizeof(char*),sizeof(char*));
+    deleteBlock(block);
+  }
+
+  friend bool operator==(PaddedAllocator, PaddedAllocator) {return true;}
+
+private:
+  static_assert(alignof(T)<=step, "PaddedAllocator aligns large arrays to 256 bytes at most");
+
+  static inline std::atomic<size_t> position{0};
+
+  static void* newBlock(size_t b)
+  {
+    if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__) return ::operator new(b,std::align_val_t{alignof(T)});
+    else return ::operator new(b);
+  }
+
+  static void deleteBlock(void* p) noexcept // unsized: Clang before 19 has no sized deallocation by default
+  {
+    if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__) ::operator delete(p,std::align_val_t{alignof(T)});
+    else ::operator delete(p);
+  }
+};
