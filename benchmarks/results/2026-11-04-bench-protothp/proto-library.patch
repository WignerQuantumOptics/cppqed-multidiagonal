-template <typename T>
-MultiArray<T,1> fromStorage(std::vector<T> v)
+/// A `StorageType<T>` is moved in; any other `std::vector<T,A>` (e.g. a plain `std::vector<T>`) is copied into one.
+template <typename T, typename A>
+MultiArray<T,1> fromStorage(std::vector<T,A> v)
 {
   const size_t s = v.size();
-  return MultiArray<T,1>{ {s}, [&] (size_t) {return std::move(v);} };
