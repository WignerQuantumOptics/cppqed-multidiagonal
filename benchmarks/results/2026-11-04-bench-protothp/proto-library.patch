+/// @brief The allocator of `StorageType`: an allocation of at least 64 KiB gets 1 KiB more, at its end.
+/**
+ * Two arrays whose size is a multiple of 1 MiB, allocated back to back, otherwise lie almost exactly a multiple of 1 MiB apart.
+ * On transparent huge pages that distance makes application up to about 3× slower (benchmarks/performance.md, "Distance on
+ * huge pages", #26), and it is what the scratch arrays of an ODE stepper get. Stateless: all instances are equal.
+ */
+template <typename T>
+struct PaddedAllocator
+{
+  using value_type = T;
+
+  static constexpr size_t padThreshold = 1uz<<16, pad = 1uz<<10;
+
+  PaddedAllocator() = default;
+  template <typename U> constexpr PaddedAllocator(const PaddedAllocator<U>&) noexcept {}
+
+  [[nodiscard]] T* allocate(size_t n)
+  {
+    if (n > (std::numeric_limits<size_t>::max()-pad)/sizeof(T)) throw std::bad_array_new_length{};
+    if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__) return static_cast<T*>(::operator new(bytes(n),std::align_val_t{alignof(T)}));
+    else return static_cast<T*>(::operator new(bytes(n)));
+  }
+
+  void deallocate(T* p, size_t) noexcept // unsized: Clang before 19 has no sized deallocation by default
+  {
+    if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__) ::operator delete(p,std::align_val_t{alignof(T)});
+    else ::operator delete(p);
+  }
+
+  friend bool operator==(PaddedAllocator, PaddedAllocator) {return true;}
+
+private:
+  static constexpr size_t bytes(size_t n) {const size_t b=n*sizeof(T); return b>=padThreshold ? b+pad : b;}
+};
+
+
+/// @brief Underlying storage type: `std::vector` with `PaddedAllocator`. May eventually be replaced by `kokkos::View` or `std::valarray`.
+template <typename T>
+using StorageType = std::vector<T,PaddedAllocator<T>>;
+
+
 /// @brief Initializer for storage of size `e` whose contents the caller overwrites before reading them.
-/// @note `std::vector<T>(e)` value-initializes, so the storage is currently zero-filled after all.
+/// @note `StorageType<T>(e)` value-initializes, so the storage is currently zero-filled after all.
 /// Don't rely on that: truly uninitialized storage would need a default-initializing allocator.
 template <typename T>
-inline constexpr auto noInit = [] (size_t e) -> std::vector<T> {return std::vector<T>(e);};
+inline constexpr auto noInit = [] (size_t e) -> StorageType<T> {return StorageType<T>(e);};
 
 /// @brief Initializer that allocates storage of size `e` and zero-initializes all elements via `T(0.)`.
 /// @todo Use `T{}` instead of `T(0.)` for generality beyond numeric types.
 template <typename T>
-inline constexpr auto zeroInit = [] (size_t e) -> std::vector<T> {return std::vector<T>(e,T(0.));};
-
